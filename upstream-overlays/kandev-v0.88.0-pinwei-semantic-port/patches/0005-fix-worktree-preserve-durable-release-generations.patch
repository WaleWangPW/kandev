+	want := load()
+	if err := repo.DeleteTask(ctx, "task-release-authority"); err != nil {
+		t.Fatal(err)
+	}
+	var count int
+	if err := repo.db.GetContext(ctx, &count, `SELECT COUNT(*) FROM task_environments WHERE id = ?`, "env-release-authority"); err != nil {
+		t.Fatal(err)
