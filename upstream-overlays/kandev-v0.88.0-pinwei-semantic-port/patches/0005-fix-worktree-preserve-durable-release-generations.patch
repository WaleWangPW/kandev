+func TestDetachTaskEnvironmentRepoLifecycleSQLiteFailureRollsBack(t *testing.T) {
+	dbPath := filepath.Join(t.TempDir(), "lifecycle-rollback.db")
+	dbConn, err := db.OpenSQLite(dbPath)
+	if err != nil {
+		t.Fatal(err)
