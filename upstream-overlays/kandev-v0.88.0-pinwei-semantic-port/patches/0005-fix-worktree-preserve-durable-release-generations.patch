+func TestSQLiteStoreMutationFenceRejectsCleanupBarrier(t *testing.T) {
+	store := newTestStore(t)
+	ctx := context.Background()
+	store.seedSessionWithEnvironment(t, "session-fenced", "task-fenced")
+	wt := &Worktree{
