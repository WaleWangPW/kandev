+			&got.WorktreeID, &got.WorktreePath, &got.WorktreeBranch,
+			&got.Position, &got.ErrorMessage, &got.Status,
+			&got.CreatedAt, &got.UpdatedAt, &got.MergedAt, &got.DeletedAt,
