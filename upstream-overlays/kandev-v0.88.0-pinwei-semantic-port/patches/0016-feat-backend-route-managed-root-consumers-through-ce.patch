+			t.Fatalf("CleanupPlainFolder error = %v, want ErrExecutorUnavailable", err)
+		}
+		if _, statErr := os.Stat(canary); statErr != nil {
+			t.Fatalf("sealed executor removed plain-folder payload: %v", statErr)
+		}
+	})
+}
