diff --git a/apps/backend/internal/system/database/reset_test.go b/apps/backend/internal/system/database/reset_test.go
index eb1edf7e3f3d3a24d3fbfd8843a17270fbf4ab26..762f4778bb1d442b6423d3cd90e631ef828d48f7 100644
