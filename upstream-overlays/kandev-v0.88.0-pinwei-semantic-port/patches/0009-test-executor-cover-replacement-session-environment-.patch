 	})
 }
 
+// TestLaunchPreparedSession_RebindsFreshSessionToExistingTaskEnvironment
+// covers the recovery boundary where the old session was removed but its
+// task-owned environment and worktree remain durable. A replacement session
+// starts without TaskEnvironmentID, yet must reuse the task environment before
+// the lifecycle can attempt a fresh worktree/provisional lease.
+func TestLaunchPreparedSession_RebindsFreshSessionToExistingTaskEnvironment(t *testing.T) {
+	repo := newMockRepository()
+	const taskID = "task-rebind"
+	const environmentID = "env-rebind"
+	const worktreeID = "worktree-rebind"
+	repo.taskRepositories["task-repository-rebind"] = &models.TaskRepository{
+		ID:           "task-repository-rebind",
+		TaskID:       taskID,
+		RepositoryID: "repository-rebind",
+		BaseBranch:   "main",
+	}
+	repo.repositories["repository-rebind"] = &models.Repository{
+		ID:        "repository-rebind",
+		LocalPath: "/tmp/rebind-repository",
+	}
+	repo.executors["executor-worktree"] = &models.Executor{
+		ID: "executor-worktree", Type: models.ExecutorTypeWorktree, Status: models.ExecutorStatusActive,
+	}
+	repo.taskEnvironments[environmentID] = &models.TaskEnvironment{
+		ID:            environmentID,
+		TaskID:        taskID,
+		Status:        models.TaskEnvironmentStatusReady,
+		WorkspacePath: "/tmp/rebind-worktree",
+		Repos: []*models.TaskEnvironmentRepo{{
+			TaskEnvironmentID: environmentID,
+			RepositoryID:      "repository-rebind",
+			BranchSlug:        "main",
+			WorktreeID:        worktreeID,
+			WorktreePath:      "/tmp/rebind-worktree",
+			WorktreeBranch:    "feature/rebind",
+		}},
+	}
+	repo.sessions["session-replacement"] = &models.TaskSession{
+		ID:             "session-replacement",
+		TaskID:         taskID,
+		AgentProfileID: "profile-123",
+		ExecutorID:     "executor-worktree",
+		State:          models.TaskSessionStateCreated,
+		StartedAt:      time.Now(),
+		UpdatedAt:      time.Now(),
+	}
+
+	var captured *LaunchAgentRequest
+	agentManager := &mockAgentManager{
+		launchAgentFunc: func(_ context.Context, req *LaunchAgentRequest) (*LaunchAgentResponse, error) {
+			captured = req
+			return &LaunchAgentResponse{AgentExecutionID: "exec-rebind", Status: v1.AgentStatusStarting}, nil
+		},
+	}
+	executor := newTestExecutor(t, agentManager, repo)
+	if _, err := executor.LaunchPreparedSession(context.Background(), &v1.Task{
+		ID: taskID, WorkspaceID: "workspace-rebind",
+	}, "session-replacement", LaunchOptions{AgentProfileID: "profile-123", ExecutorID: "executor-worktree", StartAgent: true}); err != nil {
+		t.Fatalf("LaunchPreparedSession: %v", err)
+	}
+	if captured == nil {
+		t.Fatal("LaunchAgent was not called")
+	}
+	if captured.TaskEnvironmentID != environmentID {
+		t.Errorf("TaskEnvironmentID = %q, want durable %q", captured.TaskEnvironmentID, environmentID)
+	}
+	if captured.WorktreeID != worktreeID {
+		t.Errorf("WorktreeID = %q, want durable %q", captured.WorktreeID, worktreeID)
+	}
+	if got := repo.sessions["session-replacement"].TaskEnvironmentID; got != environmentID {
+		t.Errorf("replacement session TaskEnvironmentID = %q, want %q", got, environmentID)
+	}
+}
+
 // TestLaunchPreparedSession_InheritsEnvFromSessionEnvironmentID pins the
 // office task-handoffs inheritance contract: when a child task's session
 // already has TaskEnvironmentID pointing at a parent / shared-group env,
