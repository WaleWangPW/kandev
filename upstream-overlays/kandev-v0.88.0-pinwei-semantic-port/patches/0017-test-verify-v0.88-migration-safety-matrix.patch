+const legacyTaskResourceCleanupJobsDDL = `
+	CREATE TABLE task_resource_cleanup_jobs (
+		id TEXT PRIMARY KEY,
+		operation_id TEXT NOT NULL UNIQUE,
+		task_id TEXT NOT NULL,
+		trigger TEXT NOT NULL,
+		state TEXT NOT NULL DEFAULT 'pending',
