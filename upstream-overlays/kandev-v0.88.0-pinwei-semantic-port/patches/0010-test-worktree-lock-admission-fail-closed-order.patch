diff --git a/apps/backend/internal/worktree/manager_test.go b/apps/backend/internal/worktree/manager_test.go
index cf99d590c028881da9fd8e3e0f8be030d28b7e35..f30ae4ed06eeda4f7573c9be8e9fb3b42c782e23 100644
