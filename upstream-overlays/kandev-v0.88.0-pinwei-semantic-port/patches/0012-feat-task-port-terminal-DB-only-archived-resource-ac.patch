+func archivedResourceRetirementRepositoryFixture(repositoryID, worktreeID string) ArchivedResourceEnvironmentRetirementRepository {
+	createdAt := time.Date(2026, 8, 1, 0, 0, 0, 0, time.UTC).Format(time.RFC3339Nano)
